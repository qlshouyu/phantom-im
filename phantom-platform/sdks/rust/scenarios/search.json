{
  "steps": [
    {
      "op": "client/new",
      "id": "client",
      "config": {
        "base_url": "https://phantom.example.test",
        "app_id": "example-app",
        "user_id": "example-user",
        "device_id": "rust-domain-scenario",
        "token_env": "PHANTOM_USER_TOKEN",
        "storage": "memory"
      }
    },
    {
      "op": "subscribe",
      "id": "events",
      "client": "client",
      "capacity": 256
    },
    {
      "op": "call",
      "id": "login",
      "client": "client",
      "method": "login",
      "params": {}
    },
    {
      "op": "call",
      "id": "ready",
      "client": "client",
      "method": "wait_ready",
      "params": {}
    },
    {
      "op": "call",
      "id": "1_search",
      "client": "client",
      "method": "search",
      "params": {
        "query": {
          "query": "测试",
          "limit": 10
        }
      }
    },
    {
      "op": "call",
      "id": "2_search_suggestions",
      "client": "client",
      "method": "search_suggestions",
      "params": {
        "query": {
          "query": "测试",
          "limit": 10
        }
      }
    },
    {
      "op": "call",
      "id": "3_search_conversation",
      "client": "client",
      "method": "search_conversation",
      "params": {
        "query": {
          "conv_id": "si_example-peer__example-user",
          "query": "测试",
          "limit": 10
        }
      }
    },
    {
      "op": "close_subscription",
      "id": "close_events",
      "subscription": "events"
    },
    {
      "op": "shutdown",
      "id": "shutdown",
      "client": "client"
    }
  ]
}
