# 必填：Phantom 单应用凭据。不得提交真实 AppSecret。
PHANTOM_WEB_IM_APP_ID=app_demo
PHANTOM_WEB_IM_APP_SECRET=replace-with-local-app-secret

# Phantom 单体地址
PHANTOM_HTTP_URL=http://127.0.0.1:28080
PHANTOM_WS_URL=ws://127.0.0.1:28080/ws

# 独立 phantom_web_im schema；账号需仅拥有该 schema 权限
WEB_IM_DB_URL="jdbc:mysql://127.0.0.1:3306/phantom_web_im?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true"
WEB_IM_DB_USERNAME=phantom_web_im
WEB_IM_DB_PASSWORD=phantom_web_im_dev

# Spring Session Redis DB 固定为 1
WEB_IM_REDIS_HOST=127.0.0.1
WEB_IM_REDIS_PORT=6379
WEB_IM_REDIS_PASSWORD=123456

WEB_IM_COOKIE_SECURE=false
WEB_IM_SESSION_COOKIE_MAX_AGE=30d
WEB_IM_TEST_MODE=true
WEB_IM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:28090,http://127.0.0.1:28090
