{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phantom IM",
  "version": "0.1.0",
  "identifier": "im.phantom.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:5273",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "resources/web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/web": "web"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Phantom IM desktop client",
    "longDescription": "Phantom IM desktop client built with Tauri 2."
  }
}
