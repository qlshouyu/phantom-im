{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Minimal permissions for the Phantom IM main window",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://phantom-im.localhost:*",
      "http://127.0.0.1:5273"
    ]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
