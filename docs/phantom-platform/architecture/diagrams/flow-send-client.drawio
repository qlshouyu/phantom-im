<mxCell id="c35" value="&lt;b&gt;我方主动受限&lt;/b&gt; &lt;span style=&quot;color:#7C4DEB&quot;&gt;DC-15/17&lt;/span&gt;&lt;br&gt;我已删除/拉黑对方：客户端本地拦截不发送；本地状态过期而到达服务端时返回 3002 / 3003" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#1E293B;fontSize=11;shadow=1;align=left;fontFamily=PingFang SC;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="1188" y="294" width="354" height="120" as="geometry"/></mxCell>
