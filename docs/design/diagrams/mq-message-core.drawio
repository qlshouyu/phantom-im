<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.4.1">
  <diagram name="消息核心架构（RocketMQ）">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 顶部：接入方与网关 -->
        <mxCell id="cl" value="接入方 App（集成 Phantom IM SDK）&#xa;iOS / Android / 桌面 / Web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F7CFF;absoluteArcSize=1;arcSize=16;shadow=1;fontColor=#1E293B;fontFamily=PingFang SC;spacingLeft=34;" vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="thirdsvc" value="接入方服务端（平台外）&#xa;本地签发 UserToken（AppSecret）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;absoluteArcSize=1;arcSize=16;shadow=1;fontColor=#1E293B;fontFamily=PingFang SC;spacingLeft=34;" vertex="1" parent="1">
          <mxGeometry x="1180" y="40" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gw" value="WS 长连接网关集群（无状态）&#xa;验签 UserToken（JWT · 多租户）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;absoluteArcSize=1;arcSize=16;shadow=1;fontColor=#1E293B;fontFamily=PingFang SC;spacingLeft=34;" vertex="1" parent="1">
          <mxGeometry x="610" y="170" width="260" height="70" as="geometry" />
        </mxCell>

        <!-- 服务层 -->
        <mxCell id="convdb" value="会话 Timeline 存储&#xa;conv_seq 有序 · 永久保存&#xa;（漫游 MD-03 根基）" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;boundedLbl=1;shadow=1;fontColor=#1E293B;fontFamily=PingFang SC;spacingLeft=34;" vertex="1" parent="1">
          <mxGeometry x="50" y="320" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="msgsvc" value="消息服务（同步收单）&#xa;① client_msg_id 幂等检查&#xa;② 分配 conv_seq，落会话 Timeline&#xa;③ 发 RocketMQ 事务消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F7CFF;absoluteArcSize=1;arcSize=16;shadow=1;fontColor=#1E293B;fontFamily=PingFang SC;spacingLeft=34;" vertex="1" parent="1">
          <mxGeometry x="380" y="310" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="bizsvc" value="业务服务群&#xa;已读 / 会话状态 / 群 / 关系（托管可选）/ 资料&#xa;产生 10 类 SyncEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F7CFF;absoluteArcSize=1;arcSize=16;shadow=1;fontColor=#1E293B;fontFamily=PingFang SC;spacingLeft=34;" vertex="1" parent="1">
          <mxGeometry x="740" y="310" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="openapi" value="OpenAPI 服务（server-to-server）&#xa;用户导入 / 禁用→踢下线 / 资料写入&#xa;应用配置（功能开关 · 秘钥轮换）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F7CFF;absoluteArcSize=1;arcSize=16;shadow=1;fontColor=#1E293B;fontFamily=PingFang SC;spacingLeft=34;" vertex="1" parent="1">
          <mxGeometry x="1100" y="310" width="280" height="110" as="geometry" />
        </mxCell>

        <!-- RocketMQ 中间带 -->
        <mxCell id="mq" value="Apache RocketMQ（服务端内部消息核心，不直达客户端）" style="swimlane;startSize=30;fillColor=#EAB308;strokeColor=#EAB308;pointerEvents=0;fontColor=#FFFFFF;swimlaneFillColor=#FFFBEB;arcSize=8;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="180" y="500" width="1300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="TOPIC_SYNC_EVENT&#xa;状态类事件统一入口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;shadow=1;fontColor=#1E293B;fontFamily=PingFang SC;spacingLeft=34;" vertex="1" parent="mq">
