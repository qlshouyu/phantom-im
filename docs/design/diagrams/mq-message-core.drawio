        </mxCell>
        <mxCell id="t1" value="TOPIC_MSG_EVENT&#xa;顺序消息 ShardingKey=conv_id&#xa;tag: new_msg / recall" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;shadow=1;fontColor=#1E293B;fontFamily=PingFang SC;spacingLeft=34;" vertex="1" parent="mq">
          <mxGeometry x="320" y="45" width="250" height="70" as="geometry" />
