<mxfile host="drawio" version="31.3.2">
  <diagram name="Phantom IM 分层架构">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Phantom IM 分层架构（Spring Boot 4.x · Maven 多模块 · 可分可合）" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1780" height="40" as="geometry" />
        </mxCell>

        <mxCell id="L1" value="L1  客户端接入层" style="swimlane;horizontal=0;startSize=44;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;接入方 App（集成 Phantom IM SDK）&lt;/b&gt;&#xa;iOS / Android / 桌面 / Web · 三端同时在线（MD-01）&#xa;本地双 Timeline 缓存 · MsgAck 游标 · SyncReq 兜底" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L1">
          <mxGeometry x="60" y="22" width="630" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;接入方服务端（平台外）&lt;/b&gt;&#xa;本地签发 UserToken（JWT · AppSecret）&#xa;调用 OpenAPI 管理用户 / 资料 / 应用配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="L1">
          <mxGeometry x="730" y="22" width="630" height="70" as="geometry" />
        </mxCell>

        <mxCell id="L2" value="L2  网关接入层" style="swimlane;horizontal=0;startSize=44;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="1400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="&lt;b&gt;WS 长连接网关集群（无状态）&lt;/b&gt;&#xa;phantom-gateway&#xa;Envelope 编解码 · UserToken 多租户验签&#xa;心跳保活 · 路由表登记与互踢 · 指令分发 SPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="L2">
          <mxGeometry x="60" y="24" width="420" height="96" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="&lt;b&gt;HTTP 接入（漫游 / 媒体）&lt;/b&gt;&#xa;LB + HTTPS&#xa;漫游分页拉取（MD-03）&#xa;媒体分片上传 / 秒传 / 下载" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="L2">
          <mxGeometry x="510" y="24" width="420" height="96" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="&lt;b&gt;OpenAPI 接入（server-to-server）&lt;/b&gt;&#xa;AppSecret 签名鉴权 · 多租户隔离&#xa;用户导入 / 禁用即时踢下线&#xa;应用配置与密钥轮换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="L2">
          <mxGeometry x="960" y="24" width="400" height="96" as="geometry" />
        </mxCell>

        <mxCell id="L3" value="L3  业务服务层" style="swimlane;horizontal=0;startSize=44;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="1400" height="300" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;消息服务&lt;/b&gt;&#xa;phantom-message&#xa;幂等 · conv_seq 取号&#xa;落库 + 事务消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="60" y="26" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;扇出服务&lt;/b&gt;&#xa;phantom-fanout&#xa;user_seq 唯一写入方&#xa;纯写扩散（≤500 人）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="280" y="26" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;同步 / 漫游服务&lt;/b&gt;&#xa;phantom-sync&#xa;SyncReq · ConvDigest&#xa;漫游分页读取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="500" y="26" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;会话服务&lt;/b&gt;&#xa;phantom-conversation&#xa;置顶 / 免打扰 / 草稿&#xa;已读位置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="720" y="26" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;群组服务&lt;/b&gt;&#xa;phantom-group&#xa;成员 / 权限 / 禁言&#xa;公告 · 逐成员已读" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="940" y="26" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;关系服务&lt;/b&gt;&#xa;phantom-relation&#xa;关系链托管（可选）&#xa;受限投递校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="1160" y="26" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;用户服务&lt;/b&gt;&#xa;phantom-user&#xa;Phantom ID 映射&#xa;极简资料（审核预留）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="60" y="146" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;b&gt;推送服务&lt;/b&gt;&#xa;phantom-push&#xa;在线推送（查路由）&#xa;离线推送决策树 NT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="280" y="146" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;b&gt;媒体服务&lt;/b&gt;&#xa;phantom-media&#xa;分片上传 / 秒传&#xa;阅后即焚清理消费者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="500" y="146" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;b&gt;搜索服务&lt;/b&gt;&#xa;phantom-search&#xa;索引消费者&#xa;查询接口（SR）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="720" y="146" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;b&gt;风控审计服务&lt;/b&gt;&#xa;phantom-risk&#xa;内容复核（预留直通）&#xa;系统撤回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="940" y="146" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;b&gt;OpenAPI 服务&lt;/b&gt;&#xa;phantom-openapi&#xa;管理面用例编排&#xa;变更汇入 SyncEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="1160" y="146" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="s13" value="每个 module 统一四层包结构：adapter（入口适配：网关指令处理器 / HTTP Controller）· application（用例编排）· domain（领域模型与规则）· infra（出口适配：DAO / MQ / service-api 调用）；经 @AutoConfiguration 暴露，launcher 引入即生效。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="L3">
          <mxGeometry x="60" y="256" width="1300" height="26" as="geometry" />
        </mxCell>

        <mxCell id="L4" value="L4  契约与共享内核层（拆合切换枢纽）" style="swimlane;horizontal=0;startSize=44;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;phantom-api-route&lt;/b&gt;&#xa;在线路由表读写契约&#xa;（推送 / 踢下线共同入口）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="L4">
          <mxGeometry x="60" y="26" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;phantom-api-user / conv / config&lt;/b&gt;&#xa;用户与禁用状态 · 会话与群成员&#xa;应用配置（AC-08 功能开关）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="L4">
          <mxGeometry x="390" y="26" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;phantom-common + phantom-proto&lt;/b&gt;&#xa;错误码 · ID 生成 · 统一异常/响应&#xa;proto/phantom/v1 单一契约来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="L4">
          <mxGeometry x="720" y="26" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;phantom-infra-*（starter 自动装配）&lt;/b&gt;&#xa;infra-mq（事务消息模板）&#xa;infra-redis（路由 Lua）· infra-db（分表）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="L4">
          <mxGeometry x="1050" y="26" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="装配规则：本地实现存在 → 同 JVM 直调（合部署）；@ConditionalOnMissingBean → gRPC Stub 经 Nacos 发现对端（分部署）。services 之间禁止直接依赖。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="L4">
          <mxGeometry x="60" y="112" width="1300" height="26" as="geometry" />
        </mxCell>

        <mxCell id="L5" value="L5  异步消息层 · Apache RocketMQ" style="swimlane;horizontal=0;startSize=44;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="&lt;b&gt;TOPIC_MSG_EVENT&lt;/b&gt;&#xa;顺序 + 事务消息&#xa;ShardingKey=conv_id&#xa;tag: new_msg / recall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="L5">
          <mxGeometry x="60" y="26" width="245" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;TOPIC_SYNC_EVENT&lt;/b&gt;&#xa;普通消息&#xa;10 类 SyncEvent 统一入口&#xa;由扇出统一取 user_seq" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="L5">
          <mxGeometry x="325" y="26" width="245" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;TOPIC_PUSH_RETRY&lt;/b&gt;&#xa;5s 延时消息&#xa;未 ACK 重推一次&#xa;（网关无状态化）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="L5">
          <mxGeometry x="590" y="26" width="245" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;TOPIC_MEDIA_PURGE&lt;/b&gt;&#xa;定时消息&#xa;阅后即焚 ttl+24h 清理&#xa;兜底发送后 30 天" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="L5">
          <mxGeometry x="855" y="26" width="245" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;%DLQ%*（死信）&lt;/b&gt;&#xa;重试 16 次耗尽&#xa;告警 + 人工补偿&#xa;“不丢”最后兜底" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="L5">
          <mxGeometry x="1120" y="26" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="同步链路只做“收单”，写扩散 / 推送 / 索引 / 风控全部异步；MQ 止于服务端内部，最后一公里仍由 WS 网关下发。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="L5">
          <mxGeometry x="60" y="122" width="1300" height="26" as="geometry" />
        </mxCell>

        <mxCell id="L6" value="L6  数据存储层" style="swimlane;horizontal=0;startSize=44;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1150" width="1400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;会话 Timeline&lt;/b&gt;&#xa;conv_seq 有序 · 永久保存&#xa;分表路由（漫游根基）" style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="L6">
          <mxGeometry x="60" y="30" width="245" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;用户同步 Timeline&lt;/b&gt;&#xa;user_seq 单调递增&#xa;扇出服务唯一写入" style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="L6">
          <mxGeometry x="325" y="30" width="245" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;Redis Cluster&lt;/b&gt;&#xa;在线路由表 route:{uid}（Lua 原子）&#xa;幂等键 · 缓存 · ACK 游标" style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="L6">
          <mxGeometry x="590" y="30" width="245" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;对象存储&lt;/b&gt;&#xa;媒体文件 · 秒传去重&#xa;TTL 到期清理" style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="L6">
          <mxGeometry x="855" y="30" width="245" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;搜索索引&lt;/b&gt;&#xa;消息 / 联系人 / 群检索&#xa;由索引消费者写入" style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="L6">
          <mxGeometry x="1120" y="30" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="LS" value="支撑与运维层（贯穿 L1 - L6）" style="swimlane;horizontal=1;startSize=36;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1490" y="90" width="330" height="1230" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="&lt;b&gt;Nacos 注册与配置中心&lt;/b&gt;&#xa;分部署形态的服务发现&#xa;AppSecret 与功能开关（AC-08）下发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="LS">
          <mxGeometry x="25" y="60" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="&lt;b&gt;可观测与告警&lt;/b&gt;&#xa;指标 / 链路追踪 / 日志&#xa;DLQ 堆积告警与人工补偿" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="LS">
          <mxGeometry x="25" y="200" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="&lt;b&gt;第三方推送通道&lt;/b&gt;&#xa;APNs / FCM / 厂商通道&#xa;离线推送最后一公里（NT）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="LS">
          <mxGeometry x="25" y="340" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="&lt;b&gt;phantom-launchers（装配层）&lt;/b&gt;&#xa;boot-monolith：单体一进程&#xa;boot-gateway：网关分离（第一刀）&#xa;boot-core / boot-push：按域拆分&#xa;每服务一个 boot-*：全微服务&#xa;业务代码零改动，CI 每 launcher 一镜像" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="LS">
          <mxGeometry x="25" y="480" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="&lt;b&gt;依赖方向强约束&lt;/b&gt;&#xa;（maven-enforcer 校验）&#xa;&#xa;launchers → services&#xa;services → service-api / infra&#xa;→ common / proto&#xa;&#xa;services 之间禁止直接依赖；&#xa;MQ 事件是服务间另一条合法通路。&#xa;各 module 各管各的表，&#xa;禁止跨 module 直读他人表。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;align=center;" vertex="1" parent="LS">
          <mxGeometry x="25" y="670" width="280" height="230" as="geometry" />
        </mxCell>
        <mxCell id="o6" value="&lt;b&gt;可靠性三要素&lt;/b&gt;&#xa;不丢：事务消息 + 重试 16 次 + DLQ&#xa;不重：msg_id + receiver_id 幂等&#xa;不乱序：conv_seq 同步分配 + 顺序消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=11;" vertex="1" parent="LS">
          <mxGeometry x="25" y="930" width="280" height="130" as="geometry" />
        </mxCell>

        <mxCell id="e12" value="WSS 长连接 / HTTPS（Envelope · Protobuf）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="L1" target="L2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" value="指令分发 SPI · Controller 适配（网关不依赖任何业务 module）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="L2" target="L3">
