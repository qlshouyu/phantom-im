<mxCell id="t63" value="launchers → services → service-api / infra / common / proto&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#E11D48&quot;&gt;✕ services 之间禁止直接依赖&lt;/b&gt;&lt;br&gt;只能依赖 service-api&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#CA8A04&quot;&gt;✓ MQ 事件&lt;/b&gt;是服务间另一条合法通路&lt;br&gt;&lt;br&gt;各 module 各管各的表，禁止跨 module 直读" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1E293B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1256" y="116" width="330" height="244" as="geometry"/></mxCell>
