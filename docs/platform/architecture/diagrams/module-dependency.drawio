<mxCell id="c65" value="&lt;b&gt;合（同 JVM）&lt;/b&gt;&lt;br&gt;launcher 同时引入调用方与被调方&lt;br&gt;本地实现自动装配 → 普通方法调用" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F7CFF;fontColor=#1E293B;fontSize=11;shadow=1;align=center;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1260" y="456" width="320" height="86" as="geometry"/></mxCell>
<mxCell id="c66" value="&lt;b&gt;分（跨进程）&lt;/b&gt;&lt;br&gt;launcher 只引入调用方 + phantom-api-*&lt;br&gt;@ConditionalOnMissingBean(本地实现)&lt;br&gt;→ gRPC stub 兜底，经 Nacos 发现对端" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontColor=#1E293B;fontSize=11;shadow=1;align=center;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1260" y="562" width="320" height="100" as="geometry"/></mxCell>
<mxCell id="c67" value="&lt;b&gt;MQ 通路不参与切换&lt;/b&gt;&lt;br&gt;message → fanout → push 等异步链路&lt;br&gt;单体形态也始终经 RocketMQ" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EAB308;fontColor=#1E293B;fontSize=11;shadow=1;align=center;fontFamily=PingFang SC;spacingLeft=34;" vertex="1" parent="1"><mxGeometry x="1260" y="682" width="320" height="86" as="geometry"/></mxCell>
<mxCell id="i68" value="" style="shape=image;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1272" y="712" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="t69" value="唯一变化点：launcher 的依赖清单与配置&lt;br&gt;业务代码零改动" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#5B21B6;fontFamily=PingFang SC;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="782" width="320" height="60" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
